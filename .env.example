# Servidor
NODE_ENV=development
PORT=3000

# Base de datos MySQL
MYSQLHOST=localhost
MYSQLUSER=root
MYSQLPASSWORD=tu_password
MYSQLDATABASE=sistema_cursos
MYSQLPORT=3306

# JWT (obligatorio en producción)
# Genera uno con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia-esto-por-un-secreto-aleatorio-largo
JWT_EXPIRES_IN=8h

# CORS: orígenes permitidos separados por coma (sin "*")
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
